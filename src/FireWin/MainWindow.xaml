<Window x:Class="FireWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FireWin"
        Icon="Assets/FireWin.ico"
        Width="960" Height="720" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 列表项：深色卡片 -->
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C33"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22345A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 版本列表项 -->
        <DataTemplate x:Key="VersionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8" Background="#2E2E36" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Index}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TotalBytesText}" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 分区列表项 -->
        <DataTemplate x:Key="PartitionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="8" Background="#2E2E36" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Drive}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VolumeLabel}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SystemTagText}" FontSize="11"
                                   Foreground="{StaticResource WarnBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="数据将被清除" FontSize="11"
                           Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 欢迎页特性卡片 -->
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="9">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/FireWin.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FireWin" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Windows 离线部署向导 · 内置 WinPE · 无需联网" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="v1.0.0 · GPL-3.0-only" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 步骤指示器 -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,11">
            <UniformGrid Columns="4">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot0" Width="24" Height="24" CornerRadius="12" Background="#2E2E36">
                        <TextBlock x:Name="StepNum0" Text="1" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepLabel0" Text="选择系统镜像" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot1" Width="24" Height="24" CornerRadius="12" Background="#2E2E36">
                        <TextBlock x:Name="StepNum1" Text="2" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepLabel1" Text="选择版本" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot2" Width="24" Height="24" CornerRadius="12" Background="#2E2E36">
                        <TextBlock x:Name="StepNum2" Text="3" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepLabel2" Text="选择目标分区" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot3" Width="24" Height="24" CornerRadius="12" Background="#2E2E36">
                        <TextBlock x:Name="StepNum3" Text="4" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepLabel3" Text="部署" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- 页面区 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">

            <!-- 页 0：欢迎 -->
            <ScrollViewer x:Name="PageWelcome" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,20,0,4">
                    <TextBlock Text="Windows 离线部署向导" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="选择 Windows 安装镜像和目标分区，本工具将自动复制镜像、组装内置 WinPE 部署环境并写入一次性引导。重启后自动进入 PE 完成安装，全程无需联网，无需安装 ADK。"/>

                    <UniformGrid Columns="3" Margin="0,22,0,0">
                        <Border Style="{StaticResource FeatureCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="内置完整 WinPE" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="成品 PE 随程序分发，启动即用，不下载任何组件。" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FeatureCard}" Margin="10,0">
                            <StackPanel>
                                <TextBlock Text="支持 ISO / WIM" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="自动挂载 ISO、识别全部系统版本，按需选择安装。" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FeatureCard}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="一键写入引导" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="一次性引导项，安装完成自动清理，不影响原系统。" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 功能入口：制作 PE 启动盘 -->
                    <Border x:Name="UsbEntryCard" Background="{StaticResource CardBrush}" CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="16,13" Margin="0,14,0,0" Cursor="Hand"
                            MouseLeftButtonUp="UsbEntryCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#22345A"
                                    VerticalAlignment="Center">
                                <TextBlock Text="U" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="制作 PE 启动盘 / 生成 ISO" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="把内置 WinPE 写入 U 盘（隐藏启动分区 + 数据分区 FWIMG）或生成可启动 ISO：UEFI / BIOS 双引导。"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="20,16" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="运行环境" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AdminIcon" Text="✓" FontSize="13"
                                           Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="管理员权限" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AdminValue" Grid.Column="2" Text="检测中…" FontSize="12"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PayloadIcon" Text="✓" FontSize="13"
                                           Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="内置 PE 资源" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PayloadValue" Grid.Column="2" Text="检测中…" FontSize="12"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FirmwareIcon" Text="✓" FontSize="13"
                                           Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="固件类型" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="FirmwareValue" Grid.Column="2" Text="检测中…" FontSize="12"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 页 1：选择镜像 -->
            <StackPanel x:Name="PageImage" MaxWidth="760" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="第一步 · 选择系统镜像" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Text="支持 Windows 原版 ISO（自动挂载并定位 install.wim），也可直接选择 WIM / ESD / SWM 镜像文件。"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="18,14" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagePathBox" IsReadOnly="True" FontSize="12"
                                 Background="{StaticResource LogBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 Padding="10,8" VerticalContentAlignment="Center"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Click="BrowseImage_Click"/>
                    </Grid>
                </Border>

                <Border x:Name="ImageResultCard" Background="{StaticResource CardBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource OkBrush}" BorderThickness="1"
                        Padding="18,14" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ImageResultTitle" Text="✓ 已识别系统镜像" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                        <TextBlock x:Name="ImageResultDetail" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ImageErrorCard" Background="{StaticResource CardBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                        Padding="18,14" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="无法识别该镜像" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock x:Name="ImageErrorDetail" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 页 2：选择版本 -->
            <StackPanel x:Name="PageVersion" MaxWidth="760" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="第二步 · 选择要安装的 Windows 版本" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Text="镜像内可能包含多个系统版本（家庭版 / 专业版等），选中其中一个作为本次安装目标。"/>
                <ListBox x:Name="VersionList" Margin="0,18,0,0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource DarkListItem}"
                         ItemTemplate="{StaticResource VersionItemTemplate}"
                         MaxHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         SelectionChanged="VersionList_SelectionChanged"/>
            </StackPanel>

            <!-- 页 3：选择分区 -->
            <StackPanel x:Name="PagePartition" MaxWidth="760" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="第三步 · 选择目标分区" FontSize="18" FontWeight="SemiBold"/>
                <Border Background="#2E2A1E" CornerRadius="10" BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1" Padding="16,12" Margin="0,14,0,0">
                    <TextBlock Text="⚠ 目标分区上的所有数据将被清除并格式化，请提前备份重要文件。当前系统盘不可作为安装目标。"
                               FontSize="12" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                </Border>
                <ListBox x:Name="PartitionList" Margin="0,14,0,0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource DarkListItem}"
                         ItemTemplate="{StaticResource PartitionItemTemplate}"
                         MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         SelectionChanged="PartitionList_SelectionChanged"/>
                <CheckBox x:Name="AutoRebootCheck" Content="系统安装完成后自动重启进入新系统"
                          IsChecked="True" FontSize="12" Margin="2,16,0,0"
                          Foreground="{StaticResource TextBrush}"/>
            </StackPanel>

            <!-- 页 4：确认并部署 -->
            <StackPanel x:Name="PageConfirm" MaxWidth="760" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="第四步 · 确认部署方案" FontSize="18" FontWeight="SemiBold"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="20,16" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" x:Key="SummaryLabel">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Setter Property="Margin" Value="0,7,12,0"/>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="SummaryValue">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Margin" Value="0,7,0,0"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Text="系统镜像" Grid.Row="0" Grid.Column="0" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryImagePath" Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryValue}"/>

                        <TextBlock Text="安装版本" Grid.Row="1" Grid.Column="0" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryImageVersion" Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValue}"/>

                        <TextBlock Text="目标分区" Grid.Row="2" Grid.Column="0" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryTarget" Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryValue}"/>

                        <TextBlock Text="固件类型" Grid.Row="3" Grid.Column="0" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryFirmware" Grid.Row="3" Grid.Column="1" Style="{StaticResource SummaryValue}"/>

                        <TextBlock Text="PE 落地位置" Grid.Row="4" Grid.Column="0" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryStaging" Grid.Row="4" Grid.Column="1" Style="{StaticResource SummaryValue}"/>
                    </Grid>
                </Border>
                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Margin="2,14,0,0"
                           Text="点击“开始部署”后：复制系统镜像到 C:\FireWinPE → 组装内置 WinPE → 写入一次性引导。完成后即可重启进入自动安装。"/>
            </StackPanel>

            <!-- 页 5：完成 -->
            <StackPanel x:Name="PageDone" MaxWidth="620" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource OkBrush}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="✓" FontSize="30" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="部署环境已就绪" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="镜像与引导已配置完成。重启后自动进入 WinPE 开始安装 Windows；安装完成后临时引导项会自动清理，系统恢复正常启动，无需手动干预。"/>
                <UniformGrid Columns="2" Margin="0,24,0,0">
                    <Button x:Name="RebootButton" Content="立即重启并开始安装"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Click="RebootButton_Click"/>
                    <Button x:Name="ExitButton" Content="稍后手动重启"
                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Click="ExitButton_Click"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- 日志 -->
        <Expander x:Name="LogExpander" Grid.Row="3" IsExpanded="False" Margin="0,12,0,0">
            <Expander.Header>
                <TextBlock Text="运行日志" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </Expander.Header>
            <Border Height="118" Background="{StaticResource LogBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0">
                <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                         Foreground="#C9D1D9" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Padding="14,10"/>
            </Border>
        </Expander>

        <!-- 底部导航 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BackButton" Content="上一步" Width="96"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Visibility="Hidden" Click="BackButton_Click"/>
            <Button x:Name="NextButton" Content="开始部署" MinWidth="150"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    Click="NextButton_Click"/>
        </Grid>
    </Grid>
</Window>
