<Window x:Class="FireWin.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FireWin · 系统安装与 PE 制作"
        Icon="Assets/FireWin.ico"
        Width="860" Height="560" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="EntryCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="24,22" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C33"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22345A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EntryIconBox" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#22345A"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部品牌 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="56" Height="56" CornerRadius="12" Background="#1B1B20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="56" Height="56" CornerRadius="12" Background="White"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Image Source="Assets/FireWin.png" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Margin="16,4,0,0">
                <TextBlock Text="FireWin" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Windows 离线部署工具 · 系统安装与 PE 启动盘，同一个程序完成"
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 任务选择 -->
        <Grid Grid.Row="1" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 一键安装系统 -->
            <Button Grid.Column="0" Style="{StaticResource EntryCard}" VerticalAlignment="Stretch"
                    Click="InstallButton_Click">
                <StackPanel>
                    <Border Style="{StaticResource EntryIconBox}">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,4 H21 V15 H3 Z" Stroke="#5B9DFF" StrokeThickness="1.6"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M12,7 V13 M8.5,10 L12,13.5 L15.5,10" Stroke="#5B9DFF"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M8,18 H16" Stroke="#5B9DFF" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="一键安装系统" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="选择 ISO / WIM 镜像，向导式完成分区、释放镜像与引导配置，全程离线。"/>
                    <TextBlock Text="进入部署向导 →" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Button>

            <!-- 制作 PE -->
            <Button Grid.Column="2" Style="{StaticResource EntryCard}" VerticalAlignment="Stretch"
                    Click="PeButton_Click">
                <StackPanel>
                    <Border Style="{StaticResource EntryIconBox}">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9,3 H15 V6 H9 Z" Stroke="#5B9DFF" StrokeThickness="1.6"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M10,6 V10 L7.5,13.5 V21 H16.5 V13.5 L14,10 V6" Stroke="#5B9DFF"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                <Path Data="M9,17 H15" Stroke="#5B9DFF" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="制作 PE 启动盘" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="把内置 WinPE 写入 U 盘（隐藏启动分区 + 数据分区），或生成可启动 ISO 文件。"/>
                    <TextBlock Text="进入 PE 制作 →" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 底部状态 -->
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <TextBlock x:Name="FooterText" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
