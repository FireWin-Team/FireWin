<Window x:Class="FireWin.UsbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FireWin · 制作 PE"
        Icon="Assets/FireWin.ico"
        Width="720" Height="680" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C33"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22345A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="UsbItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="8" Background="#2E2E36" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Drive}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VolumeLabel}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="数据将被清除" FontSize="11"
                           Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 制作方式选择按钮 -->
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource CardBrush}"
                                Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C33"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22345A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Windows 11 风格进度条：圆角轨道 + 强调色填充 -->
        <Style x:Key="Win11ProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#2A2A31"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="制作 PE" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="把内置 WinPE 写入 U 盘或生成可启动 ISO：UEFI 与 Legacy BIOS 双引导，从介质启动后即可维护系统或安装 Windows。"/>
        </StackPanel>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 制作方式 -->
                <Grid>
                    <TextBlock Text="制作方式" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="UsbModeRadio" GroupName="MediaMode" Content="写入 U 盘"
                                     Style="{StaticResource ModeRadio}" Checked="ModeRadio_Checked"/>
                        <RadioButton x:Name="IsoModeRadio" GroupName="MediaMode" Content="生成 ISO 文件"
                                     Style="{StaticResource ModeRadio}" Checked="ModeRadio_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- 模式一：U 盘 -->
                <StackPanel x:Name="UsbPanel" Margin="0,12,0,0">
                    <Border Background="#2E2A1E" CornerRadius="10" BorderBrush="{StaticResource WarnBrush}"
                            BorderThickness="1" Padding="16,12">
                        <TextBlock x:Name="UsbWarningText"
                                   Text="⚠「全新制作」会重新分区并格式化 U 盘，数据将被清除；「升级启动盘」只替换启动分区里的 PE，数据分区与镜像保持不动。操作过程中请勿拔出 U 盘。"
                                   FontSize="12" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选择 U 盘" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新列表" Width="88"
                                Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click"/>
                    </Grid>

                    <ListBox x:Name="UsbList" Margin="0,10,0,0"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource DarkListItem}"
                             ItemTemplate="{StaticResource UsbItemTemplate}"
                             MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             SelectionChanged="UsbList_SelectionChanged"/>

                    <TextBlock x:Name="UpgradeHintText" FontSize="11" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="「全新制作」会重新分区并清空 U 盘；已有 FireWin 启动盘时可用「升级启动盘」，只更新 PE，保留数据分区与镜像。"/>
                </StackPanel>

                <!-- 模式二：ISO -->
                <StackPanel x:Name="IsoPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="16,12">
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="生成一个 .iso 文件，不会改动任何磁盘。可刻录到光盘、挂载到虚拟机（VMware / Hyper-V / VirtualBox）或写入 U 盘/移动硬盘后启动，支持 UEFI 与 Legacy BIOS。"/>
                    </Border>

                    <TextBlock Text="ISO 输出位置" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Margin="0,14,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IsoPathBox" FontSize="12"
                                 Background="{StaticResource LogBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 Padding="10,7" VerticalContentAlignment="Center"
                                 TextWrapping="NoWrap"/>
                        <Button x:Name="BrowseIsoButton" Grid.Column="1" Content="浏览…" Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}" Click="BrowseIso_Click"/>
                    </Grid>
                </StackPanel>

                <!-- 可选：系统镜像 -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="16,12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="（可选）随介质写入系统镜像" FontSize="13" FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImagePathBox" IsReadOnly="True" FontSize="12"
                                     Background="{StaticResource LogBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Padding="10,7" VerticalContentAlignment="Center"
                                     TextWrapping="NoWrap"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="BrowseImage_Click"/>
                        </Grid>
                        <TextBlock x:Name="ImageHintText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="支持 ISO / WIM / ESD。镜像会复制到数据分区 \FWIMG 目录；启动 PE 后点「安装系统」即可选择安装，不需要联网和光驱。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 日志 -->
        <Expander x:Name="LogExpander" Grid.Row="2" IsExpanded="False" Margin="0,12,0,0">
            <Expander.Header>
                <TextBlock Text="运行日志" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </Expander.Header>
            <Border Height="110" Background="{StaticResource LogBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0">
                <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                         Foreground="#C9D1D9" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Padding="14,10"/>
            </Border>
        </Expander>

        <!-- 制作进度（开始后显示） -->
        <Border x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed"
                Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="ProgressStepText" FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="BuildProgressBar" Height="10" Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource Win11ProgressBar}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button Content="返回" Width="96" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="CloseButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CreateButton" Content="全新制作" MinWidth="130" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}" IsEnabled="False"
                        Click="CreateButton_Click"/>
                <Button x:Name="UpgradeButton" Content="升级启动盘" MinWidth="130"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False"
                        Click="UpgradeButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
